{
  "name": "sweed-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.7",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "mastra:dev": "bun run --cwd apps/web mastra:dev",
    "mastra:build": "bun run --cwd apps/web mastra:build",
    "mastra:studio:deploy": "bun run --cwd apps/web mastra:studio:deploy",
    "mastra:server:deploy": "bun run --cwd apps/web mastra:server:deploy",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "unit": "bun run --cwd apps/web unit",
    "typecheck": "bun run --cwd apps/web typecheck",
    "lint": "bun run --cwd apps/web lint",
    "smoke": "bun run --cwd apps/web smoke",
    "clean": "bun run --cwd apps/web clean"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.45",
    "@mastra/core": "^1.31.0",
    "@mastra/editor": "^0.7.22",
    "@mastra/libsql": "^1.9.1",
    "@mastra/loggers": "^1.1.1",
    "@mastra/memory": "^1.17.4",
    "ai": "^6.0.174",
    "convex": "^1.40.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-auto-scroll": "^8.6.0",
    "lucide-react": "^0.546.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "tom-select": "^2.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bun": "^1.3.13",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "mastra": "^1.7.3",
    "typescript": "~5.8.2"
  }
}
