{
  "name": "sweed-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.7",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "mastra:dev": "bun run --cwd apps/web mastra:dev",
    "mastra:build": "bun run --cwd apps/web mastra:build",
    "mastra:studio:deploy": "bun run --cwd apps/web mastra:studio:deploy",
    "mastra:server:deploy": "bun run --cwd apps/web mastra:server:deploy",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "unit": "bun run --cwd apps/web unit",
    "typecheck": "bun run --cwd apps/web typecheck",
    "typecheck:packages": "tsc -p packages/tsconfig.json --noEmit",
    "lint": "bun run --cwd apps/web lint",
    "smoke": "bun run --cwd apps/web smoke",
    "clean": "bun run --cwd apps/web clean"
  }
}
