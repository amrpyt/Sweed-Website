{
  "name": "@sweed/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "mastra:dev": "mastra dev --dir src/mastra",
    "mastra:build": "mastra build --dir src/mastra",
    "mastra:studio:deploy": "mastra studio deploy",
    "mastra:server:deploy": "mastra server deploy",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "unit": "bun test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src next.config.ts eslint.config.mjs",
    "smoke": "playwright test",
    "smoke:prod": "playwright test -c playwright.production.config.ts",
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item -Recurse -Force .next,dist -ErrorAction SilentlyContinue\""
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.45",
    "@heroui/react": "^3.1.0",
    "@heroui/styles": "^3.1.0",
    "@mastra/core": "^1.31.0",
    "@mastra/editor": "^0.7.22",
    "@mastra/libsql": "^1.9.1",
    "@mastra/loggers": "^1.1.1",
    "@mastra/memory": "^1.17.4",
    "@sweed/brand": "workspace:*",
    "@sweed/content": "workspace:*",
    "@sweed/ui": "workspace:*",
    "@tailwindcss/postcss": "^4.3.0",
    "ai": "^6.0.174",
    "convex": "^1.40.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-auto-scroll": "^8.6.0",
    "lucide-react": "^0.546.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.0",
    "tom-select": "^2.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bun": "^1.3.13",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "mastra": "^1.7.3",
    "typescript": "~5.8.2"
  }
}
